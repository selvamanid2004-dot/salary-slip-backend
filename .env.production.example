# ====================================================================
# WorkPulse Enterprise - Production Environment Configuration Template
# Copy this file to .env on your live production server and fill in secrets
# ====================================================================

# 1. Server Environment
PORT=5000
NODE_ENV=production

# 2. Security & Authentication
# CRITICAL: Replace with a unique random secret string (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_for_production

# 3. CORS Domain Restriction
# Specify your live website domain (e.g., https://payroll.yourdomain.com) or leave * for any
CORS_ORIGIN=https://payroll.yourdomain.com

# 4. Production MySQL / MariaDB Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=payroll_app_user
DB_PASSWORD=your_secure_database_password_here
DB_NAME=salary_slip_db

# 5. Application Logging Level
LOG_LEVEL=info
